# ReSukiSU - optional kernel root variant
#
# This fragment is NOT part of the normal UMI kernel configuration.
# It must be merged explicitly when building the ReSukiSU variant.

CONFIG_KSU=y
CONFIG_KSU_MANUAL_HOOK=y

# Linux 4.19 can use the automatic ReSukiSU hooks for these paths.
CONFIG_KSU_MANUAL_HOOK_AUTO_SETUID_HOOK=y
CONFIG_KSU_MANUAL_HOOK_AUTO_INITRC_HOOK=y
CONFIG_KSU_MANUAL_HOOK_AUTO_INPUT_HOOK=y

# Keep debugging/testing facilities disabled for production builds.
# CONFIG_KSU_DEBUG is not set
# CONFIG_KSU_TOOLKIT_SUPPORT is not set

# Phase 1 deliberately excludes SUSFS.
# CONFIG_KSU_SUSFS is not set
